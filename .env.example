# All optional — the defaults already point at your current R2 setup.
NEXT_PUBLIC_PIXORA_R2_BASE_URL=https://cdn.roselanesbyjeev.in
NEXT_PUBLIC_PIXORA_PREFIX=roselanesbyjeev
NEXT_PUBLIC_PIXORA_GALLERY_FILE=temp.json

# Only if you build a backend that saves favorites back to R2 (see README).
# Leave empty to keep favorites in the visitor's browser only.
NEXT_PUBLIC_PIXORA_FAVORITES_ENDPOINT=
